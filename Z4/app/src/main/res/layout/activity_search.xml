<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Search type:"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <RadioGroup
        android:id="@+id/radioGroupSearchType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <RadioButton
            android:id="@+id/radioSongsByName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Search songs by song name"
            android:checked="true" />

        <RadioButton
            android:id="@+id/radioSongsByArtist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Search songs by artist" />

        <RadioButton
            android:id="@+id/radioSongsByGenre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Search songs by genre" />

        <RadioButton
            android:id="@+id/radioSongsInPlaylist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Search songs in playlist" />

        <RadioButton
            android:id="@+id/radioSearchArtists"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Search artists" />

        <RadioButton
            android:id="@+id/radioSearchGenres"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Search genres" />

    </RadioGroup>

    <TextView
        android:id="@+id/textViewSongName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Song name:"
        android:textSize="16sp"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/editTextSongName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:hint="Enter song name" />

    <TextView
        android:id="@+id/textViewGenre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Genre name:"
        android:textSize="16sp"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />

    <EditText
        android:id="@+id/editTextGenreName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:hint="Enter genre name"
        android:visibility="gone" />

    <TextView
        android:id="@+id/textViewArtist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Artist name:"
        android:textSize="16sp"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />

    <EditText
        android:id="@+id/editTextArtistName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:hint="Enter artist name"
        android:visibility="gone" />

    <TextView
        android:id="@+id/textViewPlaylist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select playlist:"
        android:textSize="16sp"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />

    <Spinner
        android:id="@+id/spinnerPlaylist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/textViewPlaylistSongName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Song name:"
        android:textSize="16sp"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />

    <EditText
        android:id="@+id/editTextPlaylistName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:hint="Enter song name"
        android:visibility="gone" />

    <TextView
        android:id="@+id/textViewSearchArtist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Artist name:"
        android:textSize="16sp"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />

    <EditText
        android:id="@+id/editTextSearchArtistName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:hint="Enter artist name"
        android:visibility="gone" />

    <TextView
        android:id="@+id/textViewSearchGenre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Genre name:"
        android:textSize="16sp"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />

    <EditText
        android:id="@+id/editTextSearchGenreName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:hint="Enter genre name"
        android:visibility="gone" />

    <Button
        android:id="@+id/buttonSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Search"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Search results:"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <ListView
        android:id="@+id/listViewResults"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>